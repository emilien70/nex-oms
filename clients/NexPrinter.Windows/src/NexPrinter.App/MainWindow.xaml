<Window x:Class="NexPrinter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEX Printer"
        Icon="Assets/NexPrinter.ico"
        Width="900"
        Height="680"
        MinWidth="820"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#3568D4">
    <Grid>
        <Grid x:Name="HomeView" Background="#3568D4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="28,22">
                <TextBlock Text="NEX Printer"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="HomeVersionText"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="#DCE7FF"
                           FontSize="13" />
            </Grid>

            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,0,0,22">
                <TextBlock Text="NEX Printer"
                           HorizontalAlignment="Center"
                           Foreground="White"
                           FontSize="46"
                           FontWeight="SemiBold" />
                <TextBlock Text="Lokalna obsługa wydruków z NEX-OMS"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,34"
                           Foreground="#DCE7FF"
                           FontSize="14" />

                <Border Width="590"
                        Height="205"
                        Background="White"
                        CornerRadius="8"
                        Padding="28">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Ellipse x:Name="HomeStatusDot"
                                     Width="10"
                                     Height="10"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="HomeStatusText"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Button Content="Logi"
                                    Style="{StaticResource HomeActionButton}"
                                    Click="ShowLogsButton_Click"
                                    Margin="0,0,16,0" />
                            <Button Content="Ustawienia"
                                    Style="{StaticResource HomeActionButton}"
                                    Click="ShowSettingsButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <TextBlock Grid.Row="2"
                       Text="Program działa w tle po zamknięciu okna."
                       HorizontalAlignment="Center"
                       Margin="0,0,0,18"
                       Foreground="#DCE7FF"
                       FontSize="12" />
        </Grid>

        <Grid x:Name="LogsView"
              Background="#3568D4"
              Visibility="Collapsed">
            <Border Margin="14"
                    Background="White"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="66" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="28,0,18,0">
                        <TextBlock Text="Logi"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource IconButton}"
                                Content="×"
                                ToolTip="Wróć do ekranu głównego"
                                Click="BackToHomeButton_Click" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <DataGrid x:Name="LogsDataGrid"
                                  Margin="18,0"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#D6DCE4"
                                  BorderBrush="#D6DCE4"
                                  BorderThickness="0,1,0,1"
                                  RowHeight="42"
                                  ColumnHeaderHeight="42"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  RowDetailsVisibilityMode="VisibleWhenSelected"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="NAZWA DOKUMENTU"
                                                    Binding="{Binding DocumentNumber}"
                                                    Width="2*" />
                                <DataGridTextColumn Header="URZĄDZENIE"
                                                    Binding="{Binding PrinterName}"
                                                    Width="2*" />
                                <DataGridTextColumn Header="STATUS"
                                                    Binding="{Binding Status}"
                                                    Width="1.25*" />
                                <DataGridTextColumn Header="DATA/GODZINA"
                                                    Binding="{Binding CompletedAt}"
                                                    Width="1.35*" />
                            </DataGrid.Columns>
                            <DataGrid.RowDetailsTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC"
                                            BorderBrush="#D6DCE4"
                                            BorderThickness="0,1,0,0"
                                            Padding="14,10">
                                        <TextBlock Text="{Binding Details}"
                                                   TextWrapping="Wrap"
                                                   Foreground="#475467"
                                                   FontSize="12" />
                                    </Border>
                                </DataTemplate>
                            </DataGrid.RowDetailsTemplate>
                        </DataGrid>

                        <TextBlock x:Name="EmptyLogsText"
                                   Text="Brak zapisanych wydruków na tym komputerze."
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#667085"
                                   FontSize="14"
                                   Visibility="Collapsed" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="28,0">
                        <Button Content="Otwórz folder logów"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Click="OpenLogsFolderButton_Click" />
                        <TextBlock x:Name="LogsCountText"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="#667085"
                                   FontSize="12" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="SettingsView"
              Background="#3568D4"
              Visibility="Collapsed">
            <Border Margin="14"
                    Background="White"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="28,0,18,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Ustawienia"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="SettingsVersionText"
                                       Margin="0,2,0,0"
                                       Foreground="#667085"
                                       FontSize="12" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource IconButton}"
                                Content="×"
                                ToolTip="Wróć do ekranu głównego"
                                Click="BackToHomeButton_Click" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="28,0,28,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border x:Name="SettingsStatusPanel"
                                Grid.Row="0"
                                Background="#F8FAFC"
                                BorderBrush="#D6DCE4"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16"
                                Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="SettingsStatusDot"
                                                 Width="9"
                                                 Height="9"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center" />
                                        <TextBlock x:Name="SettingsStatusTitle"
                                                   FontWeight="SemiBold"
                                                   FontSize="15" />
                                    </StackPanel>
                                    <TextBlock x:Name="SettingsStatusMessage"
                                               Margin="17,4,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="#667085"
                                               FontSize="13" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           x:Name="LastConnectionText"
                                           Margin="20,0,0,0"
                                           Foreground="#667085"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border x:Name="ProgramSettingsPanel"
                                Grid.Row="1"
                                BorderBrush="#D6DCE4"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16"
                                Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <TextBlock Text="Program"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Button Content="Otwórz folder logów"
                                            Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Right"
                                            MinHeight="32"
                                            Padding="12,5"
                                            Click="OpenLogsFolderButton_Click" />
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Uruchamiaj NEX Printer razem z Windows"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="AutostartStatusText"
                                                   Text="Program uruchomi się w tle i pozostanie w zasobniku systemowym."
                                                   Margin="0,3,0,0"
                                                   Foreground="#667085"
                                                   FontSize="12"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1"
                                                  x:Name="AutostartToggle"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  ToolTip="Uruchamiaj NEX Printer razem z Windows"
                                                  Click="AutostartToggle_Click" />
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Pokazuj powiadomienia Windows o błędach wydruku"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0" />
                                    <ToggleButton Grid.Column="1"
                                                  x:Name="ShowErrorNotificationsToggle"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  ToolTip="Pokazuj powiadomienia Windows o nieudanych wydrukach"
                                                  Click="ApplicationSettingToggle_Click" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Border x:Name="PairingPanel"
                                Grid.Row="2"
                                BorderBrush="#D6DCE4"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Połącz program z NEX-OMS"
                                           FontSize="17"
                                           FontWeight="SemiBold" />

                                <Grid Grid.Row="1" Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Adres NEX-OMS"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,6" />
                                        <TextBox x:Name="ServerUrlTextBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Nazwa komputera"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,6" />
                                        <TextBox x:Name="ComputerNameTextBox"
                                                 MaxLength="120" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Kod połączenia"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,6" />
                                        <TextBox x:Name="PairingCodeTextBox"
                                                 MaxLength="32"
                                                 CharacterCasing="Upper"
                                                 FontFamily="Consolas"
                                                 FontSize="18" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            x:Name="ConnectButton"
                                            Content="Połącz"
                                            Style="{StaticResource PrimaryButton}"
                                            Margin="16,23,0,0"
                                            Click="ConnectButton_Click" />
                                </Grid>

                                <TextBlock Grid.Row="3"
                                           x:Name="PairingErrorText"
                                           Foreground="#B42318"
                                           Margin="0,12,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <Border x:Name="ConnectedPanel"
                                Grid.Row="2"
                                BorderBrush="#D6DCE4"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="20"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Połączony program"
                                           FontSize="17"
                                           FontWeight="SemiBold" />

                                <Grid Grid.Row="1" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Text="Komputer"
                                               Foreground="#667085"
                                               Margin="0,0,12,9" />
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="1"
                                               x:Name="ConnectedComputerText"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,9" />
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="0"
                                               Text="Serwer"
                                               Foreground="#667085"
                                               Margin="0,0,12,0" />
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               x:Name="ConnectedServerText"
                                               TextWrapping="Wrap" />
                                </Grid>

                                <Border Grid.Row="2"
                                        Background="#F8FAFC"
                                        BorderBrush="#D6DCE4"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="14"
                                        Margin="0,16,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Kolejka wydruku"
                                                       FontSize="12"
                                                       Foreground="#667085" />
                                            <TextBlock x:Name="PrintJobStatusTitle"
                                                       Margin="0,4,0,0"
                                                       FontSize="15"
                                                       FontWeight="SemiBold" />
                                            <TextBlock x:Name="PrintJobStatusMessage"
                                                       Margin="0,3,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="#475467" />
                                            <TextBlock x:Name="PrintJobStatusDetails"
                                                       Margin="0,7,0,0"
                                                       TextWrapping="Wrap"
                                                       FontSize="12"
                                                       Foreground="#667085"
                                                       Visibility="Collapsed" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   x:Name="PrintJobStatusTime"
                                                   Margin="20,0,0,0"
                                                   FontSize="12"
                                                   Foreground="#667085"
                                                   VerticalAlignment="Top" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="3"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,16,0,0">
                                    <Button x:Name="SynchronizeNowButton"
                                            Content="Synchronizuj teraz"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="0,0,10,0"
                                            Click="SynchronizeNowButton_Click" />
                                    <Button Content="Usuń połączenie lokalne"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="DisconnectButton_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
