<Project>
  <PropertyGroup>
    <NexPrinterVersion>0.5.0</NexPrinterVersion>
    <Version>$(NexPrinterVersion)</Version>
    <AssemblyVersion>$(NexPrinterVersion).0</AssemblyVersion>
    <FileVersion>$(NexPrinterVersion).0</FileVersion>
    <InformationalVersion>$(NexPrinterVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>
</Project>
